<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ─── Parent: Spring Boot BOM ─────────────────────────────────── -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!-- ─── Project Coordinates ──────────────────────────────────────── -->
    <groupId>com.experiment</groupId>
    <artifactId>fsd2-exp-3-2-1</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>FSD2 Experiment 3.2.1 – CI Pipeline</name>
    <description>
        Continuous Integration pipeline demonstrating unit, integration,
        contract (Pact) and infrastructure (Testcontainers) testing.
    </description>

    <!-- ─── Modules ───────────────────────────────────────────────────── -->
    <modules>
        <module>product-service</module>
        <module>order-service</module>
    </modules>

    <!-- ─── Shared Properties ────────────────────────────────────────── -->
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Pact -->
        <pact.version>4.6.7</pact.version>
        <!-- Testcontainers -->
        <testcontainers.version>1.19.8</testcontainers.version>
    </properties>

    <!-- ─── Shared Dependency Management ─────────────────────────────── -->
    <dependencyManagement>
        <dependencies>
            <!-- Testcontainers BOM -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ─── Build Plugins Shared Config ──────────────────────────────── -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <!-- Run both unit tests and integration tests -->
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
